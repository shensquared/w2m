# Environment for the hosted w2m-mcp service.
# Copy to /etc/w2m-mcp/env, then: sudo chown root:root /etc/w2m-mcp/env && sudo chmod 600 /etc/w2m-mcp/env
# Never commit the filled-in copy.

# Public URL of the endpoint, no trailing slash. The MCP endpoint is this URL plus /mcp.
W2M_MCP_BASE_URL=https://w2m-mcp.shenshen.mit.edu

# From the GitHub OAuth App (Settings > Developer settings > OAuth Apps).
W2M_MCP_GITHUB_CLIENT_ID=Ov23li...
W2M_MCP_GITHUB_CLIENT_SECRET=...

# GitHub usernames allowed to use the tools, separated by commas or spaces. Case does not matter.
W2M_MCP_ALLOWED_GITHUB_USERS=shensquared

# Signs the access tokens the server hands to MCP clients. Any long random string:
#   openssl rand -hex 32
# Changing it signs everyone out. If left unset, a key is derived from the client secret.
W2M_MCP_JWT_SIGNING_KEY=...

# Listen address and port. The unit file sets these; nginx on portal proxies to them.
#W2M_MCP_HOST=0.0.0.0
#W2M_MCP_PORT=8765

# The server runs on the same machine as the w2m API, so it calls the API directly.
W2M_API_URL=http://127.0.0.1:3034
# The website used to build poll links. Leave unset for the default.
#W2M_SITE_URL=https://w2m.shenshen.mit.edu
